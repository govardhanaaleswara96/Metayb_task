{
  "name": "distributor-assessment",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "db:generate": "npm run db:generate -w backend",
    "db:migrate": "npm run db:migrate -w backend",
    "db:seed": "npm run db:seed -w backend",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "dev:backend": "npm run dev -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "setup": "node scripts/prepare-env.cjs && npm run db:generate && npm run db:migrate && npm run db:seed"
  },
  "devDependencies": {
    "node": "22.14.0"
  },
  "engines": {
    "node": ">=22.14.0"
  }
}
