  "tier" TEXT [not null, default: `'BRONZE'`]
  indexes {
    ("userId") [name: "Distributor_userId_key", unique]
  }
  Note: '''CHECK (creditLimitMinor >= 0)
CHECK (tier IN ('BRONZE','SILVER','GOLD'))'''
}

